# Waraqah backend — every setting, with placeholders.
# Copy to `.env` for local development (`.env` is git-ignored) and fill in real values.
# In production (Render) set these as environment variables; never commit real values.
# Keep this file in sync with internal/platform/config/config.go (BACKEND_PLAN.md §18).

# ── App ──────────────────────────────────────────────────────────────
# development | test | production
APP_ENV=development
# Port the HTTP server listens on (Render sets PORT itself).
PORT=8080
# Every API route is served under this prefix; the app's API_BASE_URL ends with it.
API_BASE_PATH=/v1
# Public URL of this API, used in links and logs.
PUBLIC_BASE_URL=http://localhost:8080
# Timezone for "today", streaks, seasons and the dashboard.
APP_TIMEZONE=Asia/Dhaka
# Comma-separated origins allowed by CORS (Flutter web dev server, deployed web app).
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8124
# Largest request body in MB (listing photos arrive as base64 in JSON).
MAX_REQUEST_BODY_MB=12
# Largest single decoded image in MB.
MAX_IMAGE_MB=4

# ── Logging ──────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
# json (production, machines) | text (local reading)
LOG_FORMAT=text
# Log SQL with timings (development only).
DEBUG_SQL=false

# ── Database (Neon PostgreSQL) ───────────────────────────────────────
# Pooled connection string used by the app.
DATABASE_URL=postgres://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Direct (non-pooled) connection string used by migrations.
DATABASE_URL_DIRECT=postgres://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require
# Local test database (docker compose service `db-test`).
DATABASE_URL_TEST=postgres://waraqah:waraqah@localhost:5433/waraqah_test?sslmode=disable
DB_MAX_CONNS=5
# Run goose migrations when the server starts (free tier has no release step).
RUN_MIGRATIONS_ON_START=true

# ── Auth ─────────────────────────────────────────────────────────────
# At least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=<generate-a-long-random-secret>
JWT_ISSUER=waraqah
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
BCRYPT_COST=12
# One-time codes for sign-up and password reset.
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
# Development only: a code that always works (the app's demo code is 123456). MUST be empty in production.
OTP_DEV_CODE=123456
# Google sign-in: comma-separated OAuth client IDs (web, Android, iOS) accepted as the ID token audience.
GOOGLE_OAUTH_CLIENT_IDS=<web-client-id>.apps.googleusercontent.com,<android-client-id>.apps.googleusercontent.com

# ── Email (OTP codes) ────────────────────────────────────────────────
# resend | brevo | log (log prints codes to the server log; development only)
EMAIL_PROVIDER=log
EMAIL_API_KEY=<email-provider-api-key>
EMAIL_FROM=Waraqah <no-reply@your-domain.example>

# ── Images (Cloudinary) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
# Root folder for every upload, e.g. waraqah-dev / waraqah-prod.
CLOUDINARY_FOLDER=waraqah-dev
# true = use the in-memory fake uploader (tests, development without keys).
CLOUDINARY_FAKE=true

# ── AI assistant (Gemini) ────────────────────────────────────────────
# Leave empty to use the rule-based replies only.
GEMINI_API_KEY=<gemini-api-key>
# A current Flash model id from the Gemini API free tier.
GEMINI_MODEL=<gemini-model-id>
GEMINI_TIMEOUT=6s
# Questions per user per minute.
AI_RATE_PER_MIN=10

# ── Rate limits ──────────────────────────────────────────────────────
# Auth requests per IP per minute.
AUTH_RATE_PER_MIN=20
# Reports per user per hour.
REPORT_RATE_PER_HOUR=30

# ── Demo behaviour and jobs (BACKEND_PLAN.md §12) ────────────────────
# Seeded demo accounts reply, rate and send books like the app's fake backend did.
DEMO_MODE=true
DEMO_BOT_DELAY=4s
# Simulated courier: a booked Sell Back pickup moves to "checking" after this.
COURIER_PICKUP_DELAY=10m
# Background ticker period.
JOBS_TICK=1m

# ── Seeding ──────────────────────────────────────────────────────────
# Password given to every seeded demo account (admin@waraqah.test, reader@waraqah.test, …).
SEED_DEMO_PASSWORD=<choose-a-demo-password>
# Safety catch: `make seed` refuses a production database unless this is true.
SEED_ALLOW_PRODUCTION=false

# ── Local tools ──────────────────────────────────────────────────────
# Where the frontend reference checkout lives (BACKEND_PLAN.md §3).
FRONTEND_DIR=./frontend
# The API the smoke test calls.
API_BASE_URL=http://localhost:8080/v1
